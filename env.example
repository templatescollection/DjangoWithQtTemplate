# Django Core Settings
# =====================

# SECURITY WARNING: keep the secret key used in production secret!
SECRET_KEY=your-secret-key-here

# SECURITY WARNING: don't run with debug turned on in production!
DEBUG=True

# ALLOWED_HOSTS should be a comma-separated list of host/domain names
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# Environment (development, staging, production)
ENVIRONMENT=development


# Database Configuration
# ======================

# For SQLite (default)
DATABASE_URL=sqlite:///db.sqlite3

# For PostgreSQL (recommended for production)
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# For MySQL
# DATABASE_URL=mysql://user:password@localhost:3306/dbname


# Email Configuration
# ===================

# SMTP Email Backend (recommended for production)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com

# Console Email Backend (for development)
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend


# Caching Configuration
# =====================

# Redis Cache (recommended for production)
# CACHE_URL=redis://127.0.0.1:6379/1

# Local Memory Cache (for development)
CACHE_URL=locmem://


# Static and Media Files
# =======================

# Static files settings (usually handled by web server in production)
STATIC_URL=/static/
STATIC_ROOT=/app/static

# Media files (user uploads)
MEDIA_URL=/media/
MEDIA_ROOT=/app/media


# Internationalization
# ====================

LANGUAGE_CODE=en-us
TIME_ZONE=UTC
USE_I18N=True
USE_L10N=True
USE_TZ=True


# Security Settings (for production)
# ==================================

# HTTPS/SSL Settings
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_BROWSER_XSS_FILTER=True
SECURE_REFERRER_POLICY=strict-origin-when-cross-origin

# CSRF and Session Settings
CSRF_COOKIE_SECURE=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_HTTPONLY=True
SESSION_COOKIE_HTTPONLY=True

# Security Headers
X_FRAME_OPTIONS=DENY
SECURE_CROSS_ORIGIN_OPENER_POLICY=same-origin


# Third-party Services
# ====================

# Add your API keys and service configurations here
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_STORAGE_BUCKET_NAME=...


# Logging Configuration
# =====================

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Sentry DSN for error tracking (optional)
# SENTRY_DSN=https://your-sentry-dsn-here


# Admin Settings
# ==============

# Django Admin URL path (change this in production for security)
ADMIN_URL=admin/

# Superuser credentials (for initial setup)
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin123
DJANGO_SUPERUSER_USERNAME=admin


# Performance Settings
# ====================

# Number of workers for Gunicorn (production)
WEB_CONCURRENCY=4

# Maximum connections per worker
WORKER_CONNECTIONS=1000


# Development Settings
# ====================

# Django Debug Toolbar (development only)
# DEBUG_TOOLBAR_ENABLED=True

# Django Extensions (development tools)
# USE_DJANGO_EXTENSIONS=True
